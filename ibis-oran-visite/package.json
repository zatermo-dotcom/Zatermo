{
  "name": "ibis-oran-visite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Visite interactive 3D du restaurant de l'hôtel ibis (Oran) – modèle paramétrique issu du portfolio ILK",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "export:glb": "node scripts/export-glb.mjs",
    "check": "node scripts/check-visite.mjs",
    "docs": "node scripts/gen-docs.mjs"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "0.178.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/three": "0.178.1",
    "@vitejs/plugin-react": "4.6.0",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
