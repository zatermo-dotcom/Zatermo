# Copier en .env puis exécuter scripts\windows\init-secrets.ps1 (génère tous les secrets aléatoires).
# Ne jamais versionner le fichier .env.

POSTGRES_PASSWORD=A_GENERER
APP_DB_PASSWORD=A_GENERER
SESSION_SECRET=A_GENERER_64_CARACTERES
MFA_ENCRYPTION_KEY=A_GENERER_64_CARACTERES

# Port local de l'interface (http://localhost:8080)
WEB_PORT=8080
# true dès que l'accès se fait en HTTPS (Tailscale Serve / certificat)
COOKIE_SECURE=false
MAX_UPLOAD_MB=200

# Sauvegardes (dossier ./backups)
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# IA locale (profil ia-locale) : laisser vide pour désactiver
OLLAMA_URL=
# OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# IA cloud : désactivée tant que ces deux valeurs sont vides
CLOUD_AI_PROVIDER=
CLOUD_AI_API_KEY=
CLOUD_AI_MODEL=claude-opus-5-5
